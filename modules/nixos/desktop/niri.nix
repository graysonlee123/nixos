{
  config,
  pkgs,
  pkgs-unstable,
  isLaptop,
  ...
}: let
  homeDir = config.users.users.gray.home;
  cursor = config.home-manager.users.gray.home.pointerCursor;
  colors = config.lib.stylix.colors.withHashtag;

  # Open: rise from slightly below while scaling up and fading in.
  openShader = ''
    vec4 open_color(vec3 coords_geo, vec3 size_geo) {
        float p = niri_clamped_progress;
        float scale = mix(0.92, 1.0, niri_progress);
        vec2 xy = (coords_geo.xy - vec2(0.5, 1.0)) / scale + vec2(0.5, 1.0);
        xy.y -= (1.0 - p) * 24.0 / size_geo.y;
        vec3 coords_tex = niri_geo_to_tex * vec3(xy, 1.0);
        return texture2D(niri_tex, coords_tex.st) * p;
    }
  '';

  # Close: shrink toward center with a slight random tilt, fading out.
  closeShader = ''
    vec4 close_color(vec3 coords_geo, vec3 size_geo) {
        float p = niri_clamped_progress;
        float scale = 1.0 - 0.12 * p;
        float dir = niri_random_seed < 0.5 ? -1.0 : 1.0;
        float angle = dir * 0.03 * p * p;
        vec2 coords = (coords_geo.xy - vec2(0.5)) * size_geo.xy;
        coords = mat2(cos(angle), -sin(angle), sin(angle), cos(angle)) * coords;
        coords = coords / scale / size_geo.xy + vec2(0.5);
        vec3 coords_tex = niri_geo_to_tex * vec3(coords, 1.0);
        return texture2D(niri_tex, coords_tex.st) * (1.0 - p);
    }
  '';
in {
  environment.systemPackages = [
    # 0.8.2 (nixpkgs-stable) broke Steam context menus
    pkgs-unstable.xwayland-satellite
  ];

  # niri config, generated by nix-wrapper-modules (`wrappers.niri`). Settings
  # render to KDL (niri-config.kdl) and are validated by niri at build time.
  #
  # https://nix-community.github.io/nix-wrapper-modules/wrapperModules/niri.html
  #
  # Nix -> KDL cheat sheet:
  #   key = 30;                          ->  key 30              (single arg)
  #   key = ["a" "b"];                   ->  key "a" "b"         (multiple args)
  #   key = { child = 1; };              ->  key { child 1 }     (child block)
  #   key = _: {};                       ->  key                 (bare flag)
  #   key = _: { props.x = 0; };         ->  key x=0             (properties)
  #   key = _: { props...; content...; } ->  key x=0 { ... }     (props + children)
  #
  # Gotcha: inside `_: { }`, children MUST go under `content`, else dropped.
  # Inspect output: build `config.wrappers.niri.wrapper`, read niri-config.kdl.
  wrappers.niri = {
    settings = {
      # General: misc top-level toggles.
      hotkey-overlay = {
        skip-at-startup = _: {};
      };
      prefer-no-csd = _: {};
      clipboard = {
        disable-primary = _: {};
      };
      gestures = {
        hot-corners = {
          off = _: {};
        };
      };
      # Match HM pointerCursor (modules/home/desktop/cursor.nix).
      cursor = {
        xcursor-theme = cursor.name;
        xcursor-size = cursor.size;
      };
      recent-windows = {
        off = _: {};
      };

      # Blur: global dual-kawase settings for all background blur (window and
      # layer rules below, plus apps requesting it via ext-background-effect,
      # e.g. vicinae). Only visible behind semitransparent surfaces.
      blur = {
        passes = 3;
        offset = 4.0;
        noise = 0.03;
        saturation = 1.4;
      };

      # Overview: zoomed-out workspaces with soft shadows.
      overview = {
        zoom = 0.5;
        workspace-shadow = {
          softness = 50;
          spread = 10;
          offset = _: {
            props = {
              x = 0;
              y = 15;
            };
          };
          color = "#00000070";
        };
      };

      # Animations: snappy springs with a hint of bounce, custom open/close
      # shaders. Springs <1.0 damping oscillate slightly at the end.
      animations = {
        workspace-switch.spring = _: {
          props = {
            damping-ratio = 0.85;
            stiffness = 900;
            epsilon = 0.0001;
          };
        };
        horizontal-view-movement.spring = _: {
          props = {
            damping-ratio = 0.9;
            stiffness = 700;
            epsilon = 0.0001;
          };
        };
        window-movement.spring = _: {
          props = {
            damping-ratio = 0.8;
            stiffness = 700;
            epsilon = 0.0001;
          };
        };
        window-resize.spring = _: {
          props = {
            damping-ratio = 0.85;
            stiffness = 800;
            epsilon = 0.0001;
          };
        };
        overview-open-close.spring = _: {
          props = {
            damping-ratio = 0.85;
            stiffness = 700;
            epsilon = 0.0001;
          };
        };
        window-open = {
          duration-ms = 280;
          curve = ["cubic-bezier" 0.05 0.7 0.1 1.0];
          custom-shader = openShader;
        };
        window-close = {
          duration-ms = 200;
          curve = "ease-out-cubic";
          custom-shader = closeShader;
        };
        screenshot-ui-open = {
          duration-ms = 250;
          curve = "ease-out-expo";
        };
      };

      outputs =
        if isLaptop
        then {
        }
        else {
          # LG UltraGear 32GS75QX-B.AUS 32"
          "DP-1" = {
            mode = "2560x1440@180.063";
            transform = "normal";
            focus-at-startup = _: {};
            position = _: {
              props = {
                x = 0;
                y = 0;
              };
            };
          };
          # ASUS ROG Strix XG129C 12.3"
          "HDMI-A-1" = {
            mode = "1920x720@75.000";
            transform = "normal";
            position = _: {
              props = {
                x = 600;
                y = 1440;
              };
            };
          };
        };

      # Input: keyboard repeat, power key left to logind.
      input = {
        disable-power-key-handling = _: {};
        keyboard = {
          repeat-delay = 300;
          repeat-rate = 75;
        };
        mouse = {
          accel-speed = -0.2;
          accel-profile = "flat";
        };
      };

      spawn-at-startup = [["swaybg" "-i" "${homeDir}/repos/me/nixos/assets/images/space-scene-lofi.png" "-m" "fill"]];

      # Layout: column widths, gaps, focus ring, shadows.
      layout = {
        gaps = 16;
        default-column-width = {
          proportion = 0.66667;
        };
        preset-column-widths = [
          {proportion = 0.33332;}
          {proportion = 0.5;}
          {proportion = 0.66667;}
        ];
        # Gradient spans the whole view, so it shifts as columns scroll.
        focus-ring = {
          width = 2;
          active-gradient = _: {
            props = {
              from = colors.base0D;
              to = colors.base0E;
              angle = 135;
              relative-to = "workspace-view";
            };
          };
          inactive-color = "${colors.base03}80";
        };
        shadow = {
          on = _: {};
          softness = 30;
          spread = 5;
          offset = _: {
            props = {
              x = 0;
              y = 5;
            };
          };
          color = "#0007";
        };
      };

      # Window rules: each list item -> one `window-rule { }` block.
      # `matches` items -> `match key="regex"` (all props). Rules without
      # `matches` apply to every window. default-* sizes only apply on open.
      window-rules = [
        # Global: rounded corners, never open maximized. Blur behind every
        # window (xray: blurs the wallpaper once, shared, nearly free); only
        # shows through translucent windows. Ring drawn around, not behind.
        {
          geometry-corner-radius = 12;
          clip-to-geometry = true;
          open-maximized = false;
          open-maximized-to-edges = false;
          draw-border-with-background = false;
          background-effect = {
            blur = true;
          };
        }
        # Unfocused windows fade slightly back.
        {
          matches = [
            {
              is-active = false;
            }
          ];
          opacity = 0.93;
        }
        # Floating windows sit over other windows: real (non-xray) blur, so
        # they frost what's underneath instead of showing the wallpaper.
        {
          matches = [
            {
              is-floating = true;
            }
          ];
          background-effect = {
            xray = false;
          };
        }
        # Windows being screencast and PiP video: keep fully opaque.
        {
          matches = [
            {
              is-window-cast-target = true;
            }
            {
              title = "^Picture in picture$";
            }
          ];
          opacity = 1.0;
        }
        # Browser PiP: float at 800x450.
        {
          matches = [
            {
              title = "^Picture in picture$";
            }
          ];
          open-floating = true;
          default-column-width = {
            fixed = 800;
          };
          default-window-height = {
            fixed = 450;
          };
        }
        # GTK portal file pickers: float at 4:3 instead of full height.
        {
          matches = [
            {
              app-id = "^xdg-desktop-portal-gtk$";
            }
          ];
          open-floating = true;
          default-column-width = {
            fixed = 1024;
          };
          default-window-height = {
            fixed = 768;
          };
        }
        # Satty: float over the workspace instead of tiling as a new column.
        {
          matches = [
            {
              app-id = "^com\\.gabm\\.satty$";
            }
          ];
          open-floating = true;
        }
        # Ghostty: open at 1/3 width.
        {
          matches = [
            {
              app-id = "^com.mitchellh.ghostty$";
            }
          ];
          default-column-width = {
            proportion = 0.33332;
          };
        }
        # Chat applications: open on HDMI-A-1 maximized to edges.
        {
          matches = [
            {
              app-id = "^vesktop$";
            }
            {
              # Google Chat PWA
              app-id = "^chrome-pommaclcbfghclhalboakcipcmmndhcj-";
            }
          ];
          open-on-output =
            if isLaptop
            then ""
            else "HDMI-A-1";
          open-maximized-to-edges = true;
          open-focused = true;
        }
      ];

      # Layer rules: same shape as window-rules, matched by namespace
      # (`niri msg layers` lists them).
      layer-rules = [
        # Frosted bar. No mako rule: it draws all notifications on one
        # surface, so blur/shadow would fill the gaps between them.
        {
          matches = [
            {
              namespace = "^waybar$";
            }
          ];
          background-effect = {
            blur = true;
          };
          popups = {
            geometry-corner-radius = 6;
            background-effect = {
              blur = true;
            };
          };
        }
      ];

      # Keybinds: attr name = key combo.
      #   "Mod+B".spawn = "x";                    ->  Mod+B { spawn "x"; }
      #   "Mod+X" = _: { props...; content...; }  ->  Mod+X repeat=false { ... }
      binds = {
        "Mod+Shift+Slash".show-hotkey-overlay = _: {};
        "Mod+Return" = _: {
          props.hotkey-overlay-title = "Open a Terminal: ghostty";
          content.spawn = ["ghostty" "+new-window"];
        };
        "Mod+Tab" = _: {
          props.hotkey-overlay-title = "Toggle Vicinae";
          content.spawn = ["vicinae" "toggle"];
        };
        "Mod+Shift+Tab" = _: {
          props.repeat = false;
          content.toggle-overview = _: {};
        };
        "Mod+B".spawn = "chromium";
        "Mod+C".spawn = "code";
        "Mod+Backslash".spawn = "thunar";
        "Mod+O".spawn = "obsidian";

        "XF86AudioLowerVolume" = _: {
          props.allow-when-locked = true;
          content.spawn-sh = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- -l 1.0";
        };
        "XF86AudioRaiseVolume" = _: {
          props.allow-when-locked = true;
          content.spawn-sh = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0";
        };
        "XF86AudioMute" = _: {
          props.allow-when-locked = true;
          content.spawn-sh = "playerctl play-pause";
        };
        "XF86MonBrightnessUp" = _: {
          props.allow-when-locked = true;
          content.spawn-sh = "brightnessctl set +5%";
        };
        "XF86MonBrightnessDown" = _: {
          props.allow-when-locked = true;
          content.spawn-sh = "brightnessctl set 5%-";
        };

        "Mod+Shift+Q" = _: {
          props.repeat = false;
          content.close-window = _: {};
        };

        "Mod+N".spawn-sh = "makoctl dismiss --all";

        "Mod+W".focus-window-up = _: {};
        "Mod+A".focus-column-left = _: {};
        "Mod+S".focus-window-down = _: {};
        "Mod+D".focus-column-right = _: {};

        "Mod+Shift+W".move-window-up = _: {};
        "Mod+Shift+A".move-column-left = _: {};
        "Mod+Shift+S".move-window-down = _: {};
        "Mod+Shift+D".move-column-right = _: {};

        "Mod+Up".focus-monitor-up = _: {};
        "Mod+Left".focus-monitor-left = _: {};
        "Mod+Down".focus-monitor-down = _: {};
        "Mod+Right".focus-monitor-right = _: {};

        "Mod+Shift+Up".move-column-to-monitor-up = _: {};
        "Mod+Shift+Left".move-column-to-monitor-left = _: {};
        "Mod+Shift+Down".move-column-to-monitor-down = _: {};
        "Mod+Shift+Right".move-column-to-monitor-right = _: {};

        "Mod+Page_Down".focus-workspace-down = _: {};
        "Mod+Page_Up".focus-workspace-up = _: {};
        "Mod+Shift+Page_Down".move-column-to-workspace-down = _: {};
        "Mod+Shift+Page_Up".move-column-to-workspace-up = _: {};

        "Mod+Ctrl+Page_Down".move-workspace-down = _: {};
        "Mod+Ctrl+Page_Up".move-workspace-up = _: {};

        "Mod+1".focus-workspace = 1;
        "Mod+2".focus-workspace = 2;
        "Mod+3".focus-workspace = 3;
        "Mod+4".focus-workspace = 4;
        "Mod+5".focus-workspace = 5;
        "Mod+6".focus-workspace = 6;
        "Mod+7".focus-workspace = 7;
        "Mod+8".focus-workspace = 8;
        "Mod+9".focus-workspace = 9;
        "Mod+Shift+1".move-column-to-workspace = 1;
        "Mod+Shift+2".move-column-to-workspace = 2;
        "Mod+Shift+3".move-column-to-workspace = 3;
        "Mod+Shift+4".move-column-to-workspace = 4;
        "Mod+Shift+5".move-column-to-workspace = 5;
        "Mod+Shift+6".move-column-to-workspace = 6;
        "Mod+Shift+7".move-column-to-workspace = 7;
        "Mod+Shift+8".move-column-to-workspace = 8;
        "Mod+Shift+9".move-column-to-workspace = 9;

        "Mod+BracketLeft".consume-or-expel-window-left = _: {};
        "Mod+BracketRight".consume-or-expel-window-right = _: {};

        "Mod+R".switch-preset-column-width = _: {};
        "Mod+Shift+R".switch-preset-column-width-back = _: {};

        "Mod+E".maximize-column = _: {};
        "Mod+M".maximize-window-to-edges = _: {};
        "Mod+Shift+M".fullscreen-window = _: {};

        "Mod+Space".center-column = _: {};

        "Mod+Minus".set-column-width = "-10%";
        "Mod+Equal".set-column-width = "+10%";

        "Mod+Shift+Minus".set-window-height = "-10%";
        "Mod+Shift+Equal".set-window-height = "+10%";

        "Mod+F"      .toggle-window-floating = _: {};
        "Mod+Shift+F".switch-focus-between-floating-and-tiling = _: {};

        "Mod+Z".toggle-column-tabbed-display = _: {};

        # gpu-screen-recorder (modules/home/apps/gpu-screen-recorder.nix).
        "Mod+X".spawn = "gsr-save";
        "Mod+Shift+X".spawn = "gsr-record";
        "Mod+Ctrl+X".spawn = "gsr-toggle";

        # Region select, then annotate in satty (modules/home/desktop/screenshots.nix).
        "Print".spawn-sh = "${pkgs.grim}/bin/grim -g \"$(${pkgs.slurp}/bin/slurp -b '#00000099' -c '#00ff41')\" - | ${pkgs.satty}/bin/satty --filename -";

        "Mod+Escape" = _: {
          props.allow-inhibiting = false;
          content.toggle-keyboard-shortcuts-inhibit = _: {};
        };
      };
    };
  };

  # Use the wrapped niri (bakes in config above) as the session package.
  programs.niri = {
    enable = true;
    package = config.wrappers.niri.wrapper;
  };

  # File pickers: GTK3 dialog (Thunar's toolkit, Stylix-themed) instead of
  # GNOME's libadwaita one. Merges into the niri module's portal defaults.
  xdg.portal.config.niri."org.freedesktop.impl.portal.FileChooser" = "gtk";

  # Wrapper's X-Reload-Triggers only honored for HM (sd-switch) units; NixOS
  # switch ignores user units, so trigger the wrapper's ExecReload ourselves.
  system.userActivationScripts.niri-reload.text = ''
    if ${config.systemd.package}/bin/systemctl --user -q is-active niri.service; then
      ${config.systemd.package}/bin/systemctl --user reload niri.service || true
    fi
  '';
}
